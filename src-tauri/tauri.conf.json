{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schema/main/schema.json",
  "productName": "BalnearioComandas",
  "version": "0.1.0",
  "identifier": "com.balneario.comandas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sistema de Gestión de Comandas - Balneario",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

